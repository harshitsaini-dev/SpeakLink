*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# JavaScript dependencies and builds
node_modules/
**/node_modules/
frontend/build/
frontend/dist/

# Runtime logs
logs/
*.log

# Emergent runtime metadata
.emergent/

# Claude local settings
.claude/settings.local.json

# VS Code local settings
.vscode/

# Archives and backups
*.zip
*.rar
*.7z
*.tar
*.tar.gz

