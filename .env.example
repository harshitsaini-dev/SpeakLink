# EchoCast HQ - repo-native configuration.
#
# Copy this file to .env in the same folder and fill it in:
#
#     copy .env.example .env      (Windows)
#     cp   .env.example .env      (macOS / Linux)
#
# .env is gitignored and must never be committed. Nothing in this file is
# read from the command line, so no value here ever appears in a process list.
#
# ---------------------------------------------------------------------------
# Where HQ listens
# ---------------------------------------------------------------------------
# 0.0.0.0 accepts connections from other machines on the LAN, which is what a
# Store needs. Use 127.0.0.1 to keep it to this computer only.
APP_HOST=0.0.0.0
APP_PORT=8000

# development | production
#
# production requires DATABASE_URL (PostgreSQL) and will NOT fall back to the
# local SQLite file. Leave this as development for the repo-native SQLite
# setup that the start scripts are built around.
APP_ENV=development

# ---------------------------------------------------------------------------
# The FIRST administrator - used ONCE, when the database does not yet exist
# ---------------------------------------------------------------------------
# These create the first OWNER account on a brand-new database and are then
# ignored for ever.
#
# Changing ADMIN_PASSWORD here does NOT reset an existing account, and changing
# ADMIN_USERNAME does NOT create a second Owner. That is deliberate: an edit to
# an environment file must never be able to silently change who can sign in to
# a running system. After the first boot, use User Management and Change
# Password.
#
# There is no default account. If these are missing when the database is being
# created, startup refuses rather than inventing a login.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=

# ---------------------------------------------------------------------------
# Signing secret
# ---------------------------------------------------------------------------
# Signs sign-in tokens. Required on every start, not just the first.
#
# Generate a strong one - at least 32 bytes:
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing it signs everybody out; it does not damage any data.
JWT_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Where the database, keys, logs and runtime state live. Defaults to <repo>/data,
# which is gitignored. Point it elsewhere to keep data outside the repository -
# a separate disk, or a backed-up volume.
#ECHOCAST_DATA_DIR=

# Browser origins allowed to call this API. NOT needed for the normal
# repo-native setup: one process serves the React app and the API on the same
# origin, so there is no cross-origin request to allow.
#
# Only needed for two-port development - the React dev server on 3000 calling
# the API on 8000. Comma separated, named exactly. '*' is refused, because this
# API sends credentials.
#CORS_ORIGINS=http://localhost:3000

# PostgreSQL, for APP_ENV=production only. Leave unset for SQLite.
#DATABASE_URL=
